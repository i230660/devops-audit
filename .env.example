# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model (must have a free tier; run `python llm.py` to list models your key can use)
GEMINI_MODEL=gemini-3.5-flash
# Optional: minimum seconds between LLM calls (free tier is limited per minute)
GEMINI_MIN_INTERVAL=5
